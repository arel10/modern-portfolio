# ============================================================
# ENVIRONMENT VARIABLES — modern-portfolio
# Copy file ini menjadi .env dan isi nilainya
# ============================================================

# --- App Settings ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_TITLE="Afcha Arel Pratama | Portfolio"
NEXT_PUBLIC_GITHUB_URL=https://github.com/afcha

# --- AI Chatbot (Google Gemini AI Studio) ---
# Dapatkan API key di https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- PostgreSQL Database ---
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/portfolio_db
DATABASE_SSL=false

# --- Admin Credentials & Auth (Initial Seed / Setup) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123
ADMIN_JWT_SECRET=your_jwt_secret_min_32_chars_random_string
